        "id": "RAGBackendBridge-1",
        "type": "genericNode",
        "position": { "x": 320, "y": 0 },
        "data": {
          "id": "RAGBackendBridge-1",
          "type": "CustomComponent",
          "node": {
            "display_name": "RAG Backend Bridge",
            "description": "Calls the FastAPI RAG backend's /query endpoint for compressed context retrieval.",
            "base_classes": ["Message"],
            "template": {
              "code": {
                "type": "code",
                "display_name": "Code",
                "value": "import httpx\nfrom langflow.custom import Component\nfrom langflow.io import IntInput, MessageTextInput, Output\nfrom langflow.schema.message import Message\n\n\nclass RAGBackendBridge(Component):\n    display_name = \"RAG Backend Bridge\"\n    description = \"Calls the FastAPI RAG backend's /query endpoint for compressed context retrieval.\"\n    icon = \"database\"\n\n    inputs = [\n        MessageTextInput(name=\"query\", display_name=\"Query\", required=True),\n        MessageTextInput(\n            name=\"backend_url\",\n            display_name=\"Backend URL\",\n            value=\"https://rag-pipeline-backend-58bv.onrender.com/query\",\n            required=True,\n        ),\n        IntInput(name=\"top_k\", display_name=\"Top K\", value=5),\n        IntInput(name=\"max_context_chars\", display_name=\"Max Context Chars\", value=4000),\n    ]\n\n    outputs = [Output(display_name=\"Context\", name=\"context\", method=\"fetch_context\")]\n\n    def fetch_context(self) -> Message:\n        payload = {\n            \"query\": self.query,\n            \"top_k\": self.top_k,\n            \"max_context_chars\": self.max_context_chars,\n        }\n        with httpx.Client(timeout=60) as client:\n            resp = client.post(self.backend_url, json=payload)\n            resp.raise_for_status()\n            data = resp.json()\n\n        return Message(text=data[\"context\"])\n"
              },
              "query": {
                "type": "str",
                "required": true,
                "display_name": "Query",
                "input_types": ["Message"],
                "value": ""
              },
              "backend_url": {
                "type": "str",
                "required": true,
                "display_name": "Backend URL",
                "value": "https://rag-pipeline-backend-58bv.onrender.com/query",
                "info": "Replace with your deployed FastAPI backend's /query URL."
              },
              "top_k": { "type": "int", "display_name": "Top K", "value": 5 },
              "max_context_chars": { "type": "int", "display_name": "Max Context Chars", "value": 4000 }
            },
            "outputs": [
              { "types": ["Message"], "selected": "Message", "name": "context", "display_name": "Context" }
            ]
          }
        }
      },
